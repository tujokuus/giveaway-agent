{
  "manifest_version": 3,
  "name": "Giveaway Agent Reader",
  "version": "0.1.0",
  "description": "Read-only page snapshots for the local Giveaway Agent.",
  "incognito": "not_allowed",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Giveaway Agent Reader"
  }
}
