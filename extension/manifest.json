{
  "manifest_version": 3,
  "name": "Giveaway Agent Reader",
  "version": "0.3.0",
  "description": "Safe page snapshots and controlled legal-content disclosure for Giveaway Agent.",
  "incognito": "not_allowed",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Giveaway Agent Reader",
    "default_popup": "popup.html"
  }
}
